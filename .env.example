APP_NAME=buhpro-api
APP_ENV=development
LOG_LEVEL=info
AUTO_MIGRATE=true

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_ALLOWED_ORIGINS=http://localhost:3000

DB_URL=postgres://buhpro:buhpro@localhost:5432/buhpro?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_TIMEOUT=2s

JWT_ISSUER=buhpro
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_LOCAL_PATH=uploads
STORAGE_PUBLIC_BASE_URL=/uploads

PAYMENTS_PROVIDER=mock
PAYMENTS_CALLBACK_URL=
PAYMENTS_PUBLIC_KEY=
PAYMENTS_SECRET_KEY=

ORDER_POSTING_FEE=1000
RESPONSE_SUBMISSION_FEE=500
DEFAULT_CURRENCY=KZT

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PUBLIC=false

ENABLE_DEV_PAYMENT_ENDPOINTS=false

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@buhpro.local
BOOTSTRAP_ADMIN_PASSWORD=Admin12345

AUTO_ASSIGN_COURSE_ON_LOW_RATING=false
DEFAULT_LOW_RATING_COURSE_ID=
